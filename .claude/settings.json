{
  "agent": "orchestrator",
  "permissions": {
    "allow": [
      "Bash(pnpm run *)",
      "Bash(pnpm install)",
      "Bash(terraform validate)",
      "Bash(terraform plan *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh api repos/*)",
      "Bash(gh api graphql *)",
      "Bash(gh run list *)",
      "Bash(gh repo view *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git rev-parse *)",
      "Bash(git status)",
      "Bash(git branch *)",
      "Bash(node ~/.claude/harness/scripts/waves/*)",
      "Bash(orca linear issue *)",
      "Bash(orca linear list-issues *)",
      "Bash(orca linear project list *)",
      "Bash(orca linear team *)",
      "Bash(orca skills get *)",
      "Bash(orca status *)",
      "Bash(orca terminal create *)",
      "Bash(orca terminal send *)",
      "Bash(orca terminal wait *)",
      "Bash(orca worktree create *)",
      "Bash(orca worktree current *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git commit --no-verify *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/auto-update.mjs",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-context.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/orchestrator-reminder.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-destructive.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/preserve-orchestrator.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
